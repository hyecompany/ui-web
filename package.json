{
  "name": "hye-ui-web",
  "private": false,
  "version": "1.0.0-edge.1",
  "license": "Apache-2.0 AND MIT",
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSES"
  ],
  "exports": {
    "./c/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./package.json": "./package.json",
    "./s/*": "./dist/styles/*.css"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js && rm -rf dist/styles && cp -r styles dist/styles"
  }
}
