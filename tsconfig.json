{
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "rootDir": ".",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}
